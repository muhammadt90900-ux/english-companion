# AI English Companion — Environment Configuration
# Copy this file to .env and adjust as needed. Every value has a safe
# local-development default (Backend Architecture §18) — none of
# these are required to get started, except OLLAMA_MODEL if you're
# not using llama3.2.

NODE_ENV=development

# --- AI / Ollama (Master Plan §13) ---
# The default below is correct when Ollama runs on the same machine as
# this app — which is the normal case, including when you practise from
# your phone: the phone talks to Next, and Next talks to Ollama. Only
# change this if Ollama lives on a *different* machine than the app.
#
# PRACTISING FROM YOUR PHONE (same Wi-Fi):
#   1. npm run dev            (already binds to 0.0.0.0)
#   2. Find your PC's LAN IP:  ipconfig   (look for IPv4 Address)
#   3. On the phone, open:     http://<that-IP>:3000
#
#   Speech recognition needs a secure context. Chrome on Android treats
#   plain http:// on a LAN IP as insecure and the microphone will not
#   start. Two ways around it, pick one:
#     a) Chrome desktop -> chrome://flags ->
#        "Insecure origins treated as secure" -> add http://<IP>:3000
#        (this flag has to be set on the *phone's* Chrome, via
#        chrome://flags on the phone itself)
#     b) Put an HTTPS tunnel in front of it (Cloudflare Tunnel, ngrok).
#        Slower, but works on any device with no per-device setup.
#   Typing still works without either — only the microphone is gated.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Model used ONLY for the Kurdish subtitles under each reply. Leave empty
# to reuse OLLAMA_MODEL.
#
# Worth setting. Kurdish Sorani is a low-resource language: llama3.2 is a
# 3B model and its Sorani is often clumsy and sometimes simply wrong. A
# larger multilingual model is markedly better at this one job, and
# because subtitles are a separate call it does not slow the conversation
# down. Try, in rough order of Kurdish quality:
#
#   ollama pull aya-expanse:8b     # multilingual by design, best bet
#   ollama pull qwen2.5:7b         # solid, widely available
#   ollama pull gemma2:9b          # needs more RAM
#
# Then set the tag here, e.g. TRANSLATION_MODEL=aya-expanse:8b
#
# If a translation comes back in English or in Arabic rather than
# Kurdish, the app shows no subtitle instead of showing you the wrong
# thing. That is the model's limit, not a bug — try a larger one.
TRANSLATION_MODEL=

CONTEXT_WINDOW_TOKEN_BUDGET=4096

# --- Database (Database Architecture §9) ---
DATABASE_PATH=./data/app.db
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4

# --- Server ---
PORT=3000

# --- Voice / TTS ---
# browser = Web Speech Synthesis (zero setup)
# piper   = local neural TTS (more natural, requires separate setup)
TTS_ENGINE=browser

# --- Logging (Backend §8) ---
LOG_LEVEL=info
# Never enable this outside your own local debugging — it logs full
# conversation content, which is off by default for privacy.
DEBUG_LOG_CONVERSATIONS=false

# --- Rate limiting (Backend §16) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- Theme ---
DEFAULT_THEME=dark
